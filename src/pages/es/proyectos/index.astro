---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { path } from '~/i18n/routes';
import { sectionLabels, pageDescriptions } from '~/i18n/ui';
import { projectsIn } from '~/lib/content';

const locale = 'es' as const;
const section = 'projects' as const;

// Tarjeta en el índice: título, una línea, stack, estado (SPEC §9).
const projects = await projectsIn(locale);
---

<Base
  locale={locale}
  section={section}
  title={sectionLabels[section][locale]}
  description={pageDescriptions[section][locale]}
  canonical={path(locale, section)}
  alternates={{ es: path('es', section), en: path('en', section) }}
>
  <Section as="div">
    <h1>{sectionLabels[section][locale]}</h1>
    <p class="lead">{pageDescriptions[section][locale]}</p>
  </Section>

  <Section>
    <ul class="entries entries--bus">
      {projects.map(({ record, slug }) => (
        <ProjectCard locale={locale} record={record} slug={slug} level={2} />
      ))}
    </ul>
  </Section>
</Base>
