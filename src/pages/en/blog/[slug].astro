---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { path, otherLocale } from '~/i18n/routes';
import { ui } from '~/i18n/ui';
import { categoryLabels, categorySlugs } from '~/i18n/taxonomy';
import { postsIn, postAlternates } from '~/lib/content';

export async function getStaticPaths() {
  const posts = await postsIn('en');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const locale = 'en' as const;
const section = 'blog' as const;

const { post } = Astro.props;
const { data } = post.entry;
const { Content } = await render(post.entry);

const alternates = await postAlternates(post.key);

// Si la pieza no está traducida, el aviso va **en el otro idioma** y al inicio,
// para que quien no lee este idioma lo decida en dos segundos (SPEC §8).
const other = otherLocale(locale);
const onlyInThisLanguage = alternates[other] === undefined;
---

<Base
  locale={locale}
  section={section}
  title={data.titulo}
  description={data.resumen}
  canonical={path(locale, section, post.slug)}
  alternates={alternates}
>
  {onlyInThisLanguage && (
    <p class="meta" lang={other}>{ui.noTranslation[other]}</p>
  )}

  <h1>{data.titulo}</h1>
  <p class="meta">
    <a href={path(locale, 'topic', categorySlugs[data.categoria][locale])}>
      {categoryLabels[data.categoria][locale]}
    </a>
    {' · '}{data.fecha_publicacion}
    {data.fecha_actualizacion && ` · ${data.fecha_actualizacion}`}
  </p>

  <Content />
</Base>
