---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import TranslationNotice from '~/components/TranslationNotice.astro';
import { path, otherLocale } from '~/i18n/routes';
import { ui, sectionLabels } from '~/i18n/ui';
import { categoryLabels, categorySlugs } from '~/i18n/taxonomy';
import { postsIn, postAlternates } from '~/lib/content';

const locale = 'en' as const;
const section = 'blog' as const;

export async function getStaticPaths() {
  // El literal, y no la constante `locale`: Astro extrae `getStaticPaths` a su
  // propio módulo, así que aquí no existe nada del ámbito del frontmatter.
  const posts = await postsIn('en');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post.entry;
const { Content } = await render(post.entry);

const alternates = await postAlternates(post.key);

// Si la pieza no está traducida, el aviso va **en el otro idioma** y al inicio,
// para que quien no lee este idioma lo decida en dos segundos (SPEC §8).
const other = otherLocale(locale);
const onlyInThisLanguage = alternates[other] === undefined;
---

<Base
  locale={locale}
  section={section}
  title={data.titulo}
  description={data.resumen}
  canonical={path(locale, section, post.slug)}
  alternates={alternates}
>
  <Band as="article" node>
    <Fragment slot="meta">
      <p>
        <a href={path(locale, 'topic', categorySlugs[data.categoria][locale])}>
          {categoryLabels[data.categoria][locale]}
        </a>
      </p>
      <p><time datetime={data.fecha_publicacion}>{data.fecha_publicacion}</time></p>
      {data.fecha_actualizacion && (
        <p>
          {ui.updated[locale]}{' '}
          <time datetime={data.fecha_actualizacion}>{data.fecha_actualizacion}</time>
        </p>
      )}
    </Fragment>

    <Breadcrumbs
      locale={locale}
      trail={[
        { label: sectionLabels[section][locale], href: path(locale, section) },
        { label: data.titulo },
      ]}
    />

    {onlyInThisLanguage && <TranslationNotice locale={locale} />}

    <h1>{data.titulo}</h1>
    <p class="lead">{data.resumen}</p>

    <div class="prose">
      <Content />
    </div>
  </Band>
</Base>
