---
import Base from '~/layouts/Base.astro';
import { path } from '~/i18n/routes';
import { pageDescriptions } from '~/i18n/ui';
import { categoryKeys, categorySlugs, categoryLabels, categoryDescriptions } from '~/i18n/taxonomy';
import { postsInCategory, categoryIsIndexed } from '~/lib/content';

// Las tres categorías son fijas (SPEC §9) y se construyen desde el día uno,
// aunque nazcan vacías: crear las rutas después obligaría a cambiar la
// navegación (ADR-0012).
export function getStaticPaths() {
  return categoryKeys.map((category) => ({
    params: { slug: categorySlugs[category]['en'] },
    props: { category },
  }));
}

const locale = 'en' as const;
const section = 'topic' as const;

const { category } = Astro.props;
const posts = await postsInCategory(locale, category);

// ADR-0012: menos de 3 posts, `noindex`. Evaluado contra el conteo real del
// build, no contra la memoria de nadie.
const indexed = await categoryIsIndexed(locale, category);

const alternates = {
  es: path('es', section, categorySlugs[category].es),
  en: path('en', section, categorySlugs[category].en),
};
---

<Base
  locale={locale}
  section={section}
  title={categoryLabels[category][locale]}
  description={pageDescriptions[section][locale]}
  canonical={path(locale, section, categorySlugs[category][locale])}
  alternates={alternates}
  noindex={!indexed}
>
  <h1>{categoryLabels[category][locale]}</h1>
  <p>{categoryDescriptions[category][locale]}</p>

  <ul class="plain">
    {posts.map((post) => (
      <li>
        <a href={path(locale, 'blog', post.slug)}>{post.entry.data.titulo}</a>
        <span class="meta"> · {post.entry.data.fecha_publicacion}</span>
      </li>
    ))}
  </ul>
</Base>
