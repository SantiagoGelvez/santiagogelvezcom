---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { path } from '~/i18n/routes';
import { projectsIn, projectAlternates } from '~/lib/content';

export async function getStaticPaths() {
  const projects = await projectsIn('en');
  return projects.map(({ record, slug }) => ({ params: { slug }, props: { record } }));
}

const locale = 'en' as const;
const section = 'projects' as const;

const { record } = Astro.props;
const { data } = record.entry;

// El cuerpo narrativo vive en su propio archivo por idioma; los metadatos, una
// sola vez en el registro. Los proyectos son bilingües en línea, así que el
// selector siempre tiene a dónde ir (ADR-0008).
const { Content } = await render(record.body[locale]);
---

<Base
  locale={locale}
  section={section}
  title={data.titulo[locale]}
  description={data.resumen[locale]}
  canonical={path(locale, section, data.slug[locale])}
  alternates={projectAlternates(record)}
>
  <h1>{data.titulo[locale]}</h1>
  <p class="meta">
    {data.rol[locale]} · {data.estado} · {data.periodo.inicio}{data.periodo.fin && ` — ${data.periodo.fin}`}
  </p>
  <p class="meta">{data.stack.join(' · ')}</p>
  {data.repo && <p><a href={data.repo}>{data.repo}</a></p>}

  <Content />
</Base>
