---
import { path, url, otherLocale, localeNames, locales, type Locale, type SectionKey } from '../i18n/routes';
import { ui, sectionLabels, navSections } from '../i18n/ui';
import { profileData } from '../lib/content';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  locale: Locale;
  /** Sección a la que pertenece la página, para el estado activo del nav. */
  section: SectionKey;
  /** Título sin sufijo; la plantilla aplica el patrón `Título — Santiago Gelvez`. */
  title: string;
  /** Escrita a mano, 150-160 caracteres (SPEC §10). Nunca truncada del cuerpo. */
  description: string;
  /** Ruta canónica de esta página. */
  canonical: string;
  /**
   * Rutas que existen de verdad para esta misma pieza, por idioma.
   * `hreflang` solo se emite entre pares reales (SPEC §8).
   */
  alternates: Partial<Record<Locale, string>>;
  /**
   * `noindex` para páginas que existen pero todavía no merecen indexarse:
   * las categorías con menos de 3 posts (ADR-0012). La página se construye y
   * navega igual; lo único que cambia es la señal a los buscadores.
   */
  noindex?: boolean;
}

const { locale, section, title, description, canonical, alternates, noindex = false } = Astro.props;

const site = Astro.site!;
const isHome = section === 'home';
const fullTitle = isHome
  ? `${ui.siteName[locale]} — ${ui.role[locale]}`
  : `${title} — ${ui.siteName[locale]}`;

const other = otherLocale(locale);
const alternateHere = alternates[other];
// Si la pieza no existe en el otro idioma, el selector nunca se desactiva ni
// desaparece: lleva al índice del blog de ese idioma, con aviso (SPEC §8).
const switchHref = alternateHere ?? path(other, 'blog');
const switchIsFallback = alternateHere === undefined;

// `x-default` apunta a la versión en español, que es el idioma por defecto.
// No a `/`, que responde 301: declarar `hreflang` hacia una URL que redirige
// es un error que Search Console reporta.
const xDefault = alternates['es'];

// El JSON-LD sale de `perfil.yml` y no de literales en la plantilla. Antes
// llevaba un GitHub y un LinkedIn escritos a mano aquí: dos URL que nadie
// validaba y que ya no coincidían con la data. `sameAs` solo lista perfiles que
// existen de verdad — es la misma regla que `hreflang` (SPEC §8), aplicada a
// los datos estructurados.
const profile = isHome ? await profileData() : undefined;
const sameAs = profile
  ? [profile.enlaces.github, profile.enlaces.linkedin, profile.enlaces.platzi].filter(
      (link): link is string => typeof link === 'string',
    )
  : [];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1A1815" />

    {/*
      Las dos fuentes que dibujan la primera pantalla: la display del titular y
      la de cuerpo. Se precargan porque están autoalojadas con ruta estable —un
      paquete de npm las publica con hash y no habría qué precargar. La mono de
      los metadatos y la cursiva no se precargan: pesan poco y llegan tarde sin
      que se note.
    */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/bricolage-grotesque-latin-opsz-wght.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/literata-latin-wght.woff2" />
    <link rel="canonical" href={new URL(canonical, site).href} />
    {locales.map((l) => {
      const href = alternates[l];
      return href ? <link rel="alternate" hreflang={l} href={new URL(href, site).href} /> : null;
    })}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site).href} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={section === 'blog' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(canonical, site).href} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    {isHome && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Person',
          // Mismo `@id` en `/es/` y `/en/`: son dos páginas que describen a la
          // misma persona, no dos personas. Sin esto Google puede tratarlas como
          // entidades distintas, que es justo lo contrario de lo que busca §10.
          '@id': 'https://santiagogelvez.com/#santiago',
          name: profile!.nombre,
          jobTitle: profile!.headline[locale],
          url: url(site, locale, 'home'),
          address: { '@type': 'PostalAddress', addressLocality: 'Duitama', addressRegion: 'Boyacá', addressCountry: 'CO' },
          sameAs,
        })}
      />
    )}
  </head>

  <body>
    <a class="skip" href="#contenido">{ui.skipToContent[locale]}</a>

    <header class="site">
      <a class="brand" href={path(locale, 'home')}>{ui.siteName[locale]}</a>
      <nav aria-label={locale === 'es' ? 'Principal' : 'Main'}>
        <ul>
          {navSections.map((key) => (
            <li>
              <a href={path(locale, key)} aria-current={key === section ? 'page' : undefined}>
                {sectionLabels[key][locale]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="lang" href={switchHref} hreflang={other} lang={other} title={switchIsFallback ? ui.noTranslation[other] : undefined}>
        {localeNames[other]}
      </a>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site">
      <p>{ui.city[locale]}</p>
      <p><a href={path(locale, 'privacy')}>{sectionLabels.privacy[locale]}</a></p>
    </footer>

  </body>
</html>
